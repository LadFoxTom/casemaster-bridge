// Casemaster-WMS — Database admin index.
// Raw view of every WMS table; useful for debugging and ad-hoc inspection.
// Each link goes to /page/wms/<table> which is a generated list view.

inherits 'base'

function main()
    page.render(page.get('./mainView'))
end-function

protected resource mainView
    <@page/container
        content: <@page/content
            sidebar: <@page/html script.call('wms/_layout:sidebar', 'db_admin')>,
            crumbs: <@page/html `<p><a href="../wms" class="btn btn-sm btn-outline-secondary">&larr; Dashboard</a></p>`>,
            title: <@page/title label: '🛠 Database admin'>,
            intro: <@page/html `<p class="text-muted">Raw list view of every WMS table (164). Useful for debugging and ad-hoc inspection. For day-to-day work use the workflow centers from the dashboard instead.</p>`>,

            grid: <@page/html
                resolveTemplate(`
                <div class="row">
                    <div class="col-lg-3 col-md-6 mb-3"><div class="card h-100"><div class="card-body">
                        <h5 class="card-title">Master Data</h5>
                        <ul class="list-unstyled mb-0">
                            <li><a href="tenant">Tenants</a></li>
                            <li><a href="site">Sites</a></li>
                            <li><a href="warehouse">Warehouses</a></li>
