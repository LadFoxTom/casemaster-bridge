                            <li><a href="carrier_service">Carrier services</a></li>
                        </ul>
                    </div></div></div>
                    <div class="col-lg-3 col-md-6 mb-3"><div class="card h-100"><div class="card-body">
                        <h5 class="card-title">Inventory &amp; tracking</h5>
                        <ul class="list-unstyled mb-0">
                            <li><a href="inventory">Stock on hand</a></li>
                            <li><a href="inventory_journal">Inventory journal</a></li>
                            <li><a href="inventory_reservation">Reservations</a></li>
