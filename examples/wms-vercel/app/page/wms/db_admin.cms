                            <li><a href="serial_unit">Serial units</a></li>
                            <li><a href="serial_event">Serial events</a></li>
                            <li><a href="recall">Recalls</a></li>
                            <li><a href="recall_lot">Recall lots</a></li>
                            <li><a href="license_plate">License plates</a></li>
                            <li><a href="license_plate_event">LPN events</a></li>
                        </ul>
                    </div></div></div>
                    <div class="col-lg-3 col-md-6 mb-3"><div class="card h-100"><div class="card-body">
                        <h5 class="card-title">Inbound</h5>
