                            <li><a href="item_slot_assignment">Slot assignments</a></li>
                            <li><a href="slot_recommendation">Slot recommendations</a></li>
                        </ul>
                    </div></div></div>
                    <div class="col-lg-3 col-md-6 mb-3"><div class="card h-100"><div class="card-body">
                        <h5 class="card-title">Outbound</h5>
