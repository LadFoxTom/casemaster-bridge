// Casemaster-WMS — shared left-sidebar layout fragment.
//
// Each workflow page calls `script.call('wms/_layout:sidebar', '<section>')`
// as its first content block. The function returns a `<style>` + `<aside>` +
// inline JS bundle that:
//
//   1. Adds a fixed left sidebar (220px wide) with links to every workflow
//      centre, with the current section highlighted.
//   2. Pushes the framework's <main> over by 220px so content doesn't sit
//      under the sidebar.
//   3. Collapses the sidebar to a thin icon strip below 992px viewports.
//
// Recognised section keys (any other value just leaves nothing highlighted):
//   dashboard, inbound, stock, outbound, reverse, counts, replen, quality,
//   yard, billing, setup, db_admin

function sidebar(active)

    return resolveTemplate(`
<style>
  /* The framework's navbar is fixed-top with height ~56px; sit under it. */
  .wms-sidebar {
      position: fixed;
      top: 56px;
      left: 0;
      bottom: 0;
      width: 220px;
      background: #f8f9fa;
      border-right: 1px solid #dee2e6;
      overflow-y: auto;
      padding: 0.75rem 0;
      z-index: 100;
      font-size: 0.92rem;
  }
  .wms-sidebar h6 {
      color: #6c757d;
      text-transform: uppercase;
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      padding: 0.5rem 1rem 0.25rem;
      margin: 0;
  }
  .wms-sidebar a {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem 1rem;
      color: #212529;
      text-decoration: none;
      border-left: 3px solid transparent;
  }
  .wms-sidebar a:hover {
      background: #e9ecef;
      color: #0d6efd;
  }
  .wms-sidebar a.active {
      background: #e7f1ff;
      color: #0d6efd;
      border-left-color: #0d6efd;
      font-weight: 600;
  }
  .wms-sidebar .wms-icon {
      display: inline-block;
      width: 1.4rem;
      text-align: center;
      font-size: 1rem;
  }
  .wms-sidebar .wms-divider {
      border-top: 1px solid #dee2e6;
      margin: 0.6rem 0;
  }
  /* Push the framework <main> right of the sidebar. */
  body > main { padding-left: 240px; }
  body > main > .container { max-width: none; }

  /* Mobile: collapse to icon strip */
  @media (max-width: 991.98px) {
      .wms-sidebar { width: 56px; }
      .wms-sidebar h6, .wms-sidebar .wms-label { display: none; }
      .wms-sidebar a { justify-content: center; padding: 0.5rem 0; }
      body > main { padding-left: 64px; }
  }
</style>
<aside class="wms-sidebar">
    <h6>Operations</h6>
    <a href="{{request.urlBase()}}/page/wms"           class="{{if(eq([active], 'dashboard'), 'active', '')}}"><span class="wms-icon">🏠</span><span class="wms-label">Dashboard</span></a>
    <a href="{{request.urlBase()}}/page/wms/inbound"   class="{{if(eq([active], 'inbound'),   'active', '')}}"><span class="wms-icon">📦</span><span class="wms-label">Inbound</span></a>
    <a href="{{request.urlBase()}}/page/wms/stock"     class="{{if(eq([active], 'stock'),     'active', '')}}"><span class="wms-icon">📊</span><span class="wms-label">Stock</span></a>
    <a href="{{request.urlBase()}}/page/wms/outbound"  class="{{if(eq([active], 'outbound'),  'active', '')}}"><span class="wms-icon">🚚</span><span class="wms-label">Outbound</span></a>

    <div class="wms-divider"></div>
    <h6>Reverse &amp; counts</h6>
    <a href="{{request.urlBase()}}/page/wms/reverse"   class="{{if(eq([active], 'reverse'),   'active', '')}}"><span class="wms-icon">↩</span><span class="wms-label">Returns</span></a>
    <a href="{{request.urlBase()}}/page/wms/counts"    class="{{if(eq([active], 'counts'),    'active', '')}}"><span class="wms-icon">🧮</span><span class="wms-label">Cycle counts</span></a>
    <a href="{{request.urlBase()}}/page/wms/replen"    class="{{if(eq([active], 'replen'),    'active', '')}}"><span class="wms-icon">🔁</span><span class="wms-label">Replenishment</span></a>

    <div class="wms-divider"></div>
    <h6>Quality &amp; yard</h6>
    <a href="{{request.urlBase()}}/page/wms/quality"   class="{{if(eq([active], 'quality'),   'active', '')}}"><span class="wms-icon">✅</span><span class="wms-label">Quality</span></a>
    <a href="{{request.urlBase()}}/page/wms/yard"      class="{{if(eq([active], 'yard'),      'active', '')}}"><span class="wms-icon">🏗</span><span class="wms-label">Yard &amp; dock</span></a>
    <a href="{{request.urlBase()}}/page/wms/billing"   class="{{if(eq([active], 'billing'),   'active', '')}}"><span class="wms-icon">💰</span><span class="wms-label">3PL billing</span></a>

    <div class="wms-divider"></div>
    <h6>System</h6>
    <a href="{{request.urlBase()}}/page/wms/setup"     class="{{if(eq([active], 'setup'),     'active', '')}}"><span class="wms-icon">⚙</span><span class="wms-label">Setup</span></a>
    <a href="{{request.urlBase()}}/page/wms/db_admin"  class="{{if(eq([active], 'db_admin'),  'active', '')}}"><span class="wms-icon">🛠</span><span class="wms-label">DB admin</span></a>
</aside>
`)

end-function
