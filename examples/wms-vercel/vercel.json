{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.ts":    { "includeFiles": "app/**" },
    "api/v1/index.ts": { "includeFiles": "{app,_runtime}/**" }
  },
  "rewrites": [
    { "source": "/api/v1/:path*",      "destination": "/api/v1?_p=/api/v1/:path*" },
    { "source": "/page/:path*",        "destination": "/api?_p=/page/:path*" },
    { "source": "/maintenance/:path*", "destination": "/api?_p=/maintenance/:path*" }
  ]
}
