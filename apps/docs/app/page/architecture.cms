inherits 'base'

function main()
    page.render(page.get('./main'))
end-function

protected resource main
    <@page/container
        content: <@page/content
            wrap:   <@page/html `<div class="cms-layout">`>,
            side:   <@page/html script.call('_layout:sidebar', 'arch')>,
            body_o: <@page/html `<div class="cms-content">`>,

            head: <@page/html `
                <h1>Architecture</h1>
                <p class="lead">One frontend, one contract, three backend shapes. The SPA can't tell the difference between them.</p>
            `>,

            big: <@page/html `
                <h2>The big picture</h2>
                <div class="arch-diagram">
                    <svg viewBox="0 0 980 540" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="cms-admin architecture diagram">
                      <defs>
                        <linearGradient id="grad-browser" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0%"  stop-color="#1a1f29"/>
                          <stop offset="100%" stop-color="#14181f"/>
                        </linearGradient>
                        <linearGradient id="grad-contract" x1="0" y1="0" x2="1" y2="0">
                          <stop offset="0%"   stop-color="#5b8bff" stop-opacity="0.15"/>
                          <stop offset="50%"  stop-color="#5b8bff" stop-opacity="0.35"/>
                          <stop offset="100%" stop-color="#5b8bff" stop-opacity="0.15"/>
                        </linearGradient>
                        <linearGradient id="grad-shape" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0%"  stop-color="#1a1f29"/>
                          <stop offset="100%" stop-color="#10141b"/>
                        </linearGradient>
                        <linearGradient id="grad-pg" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0%"  stop-color="#1a3a2a"/>
                          <stop offset="100%" stop-color="#10241a"/>
                        </linearGradient>
                        <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
                          <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#000" flood-opacity="0.4"/>
                        </filter>
                        <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
                          <path d="M0,0 L10,5 L0,10 Z" fill="#5b8bff"/>
                        </marker>
                        <marker id="arrow-muted" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                          <path d="M0,0 L10,5 L0,10 Z" fill="#5d6776"/>
                        </marker>
                      </defs>

                      <!-- BROWSER -->
                      <g filter="url(#shadow)">
                        <rect x="60" y="20" width="860" height="120" rx="14" fill="url(#grad-browser)" stroke="#2a3140"/>
                      </g>
                      <text x="490" y="50" text-anchor="middle" font-family="ui-monospace,monospace" font-size="11" font-weight="700" letter-spacing="0.15em" fill="#7d8694">BROWSER</text>

                      <!-- SPA + features pills -->
                      <g transform="translate(85, 70)">
                        <rect x="0" y="0" width="220" height="56" rx="10" fill="#161b22" stroke="#2a3140"/>
                        <text x="14" y="22" font-family="Inter,sans-serif" font-size="13" font-weight="600" fill="#e6edf3">@casemaster/admin</text>
                        <text x="14" y="40" font-family="Inter,sans-serif" font-size="11" fill="#7d8694">React + Vite + TypeScript</text>
                      </g>
                      <g font-family="Inter,sans-serif" font-size="10.5" fill="#c0c9d6">
                        <g transform="translate(330, 70)">
                          <rect x="0" y="0" width="118" height="24" rx="12" fill="rgba(91,139,255,0.10)" stroke="rgba(91,139,255,0.3)"/>
                          <text x="14" y="16">⌘K palette</text>
                        </g>
                        <g transform="translate(456, 70)">
                          <rect x="0" y="0" width="148" height="24" rx="12" fill="rgba(91,139,255,0.10)" stroke="rgba(91,139,255,0.3)"/>
                          <text x="14" y="16">virtualized grids</text>
                        </g>
                        <g transform="translate(612, 70)">
                          <rect x="0" y="0" width="160" height="24" rx="12" fill="rgba(91,139,255,0.10)" stroke="rgba(91,139,255,0.3)"/>
                          <text x="14" y="16">optimistic mutations</text>
                        </g>
                        <g transform="translate(330, 102)">
                          <rect x="0" y="0" width="120" height="24" rx="12" fill="rgba(74,222,128,0.10)" stroke="rgba(74,222,128,0.3)"/>
                          <text x="14" y="16" fill="#9ddfb1">live (SSE)</text>
                        </g>
                        <g transform="translate(458, 102)">
                          <rect x="0" y="0" width="130" height="24" rx="12" fill="rgba(74,222,128,0.10)" stroke="rgba(74,222,128,0.3)"/>
                          <text x="14" y="16" fill="#9ddfb1">page actions</text>
                        </g>
                        <g transform="translate(596, 102)">
                          <rect x="0" y="0" width="176" height="24" rx="12" fill="rgba(245,158,11,0.10)" stroke="rgba(245,158,11,0.3)"/>
                          <text x="14" y="16" fill="#f4c478">Copilot (BYO key)</text>
                        </g>
                        <g transform="translate(780, 70)">
                          <rect x="0" y="0" width="124" height="24" rx="12" fill="rgba(255,255,255,0.04)" stroke="#2a3140"/>
                          <text x="14" y="16">dark / light</text>
                        </g>
                        <g transform="translate(780, 102)">
                          <rect x="0" y="0" width="124" height="24" rx="12" fill="rgba(255,255,255,0.04)" stroke="#2a3140"/>
                          <text x="14" y="16">density toggle</text>
                        </g>
                      </g>

                      <!-- arrow browser → contract -->
                      <line x1="490" y1="140" x2="490" y2="186" stroke="#5b8bff" stroke-width="2" marker-end="url(#arrow)" stroke-dasharray="0"/>
                      <text x="500" y="170" font-family="ui-monospace,monospace" font-size="10" fill="#7d8694">JSON over fetch</text>

                      <!-- CONTRACT BAR -->
                      <g>
                        <rect x="60" y="190" width="860" height="36" rx="10" fill="url(#grad-contract)" stroke="rgba(91,139,255,0.4)"/>
                        <text x="490" y="213" text-anchor="middle" font-family="ui-monospace,monospace" font-size="13" font-weight="700" fill="#cfdaff" letter-spacing="0.04em">/api/v1/*  ·  versioned JSON contract  ·  schemas in @casemaster/api-spec</text>
                      </g>

                      <!-- arrow contract → shapes -->
                      <line x1="490" y1="226" x2="490" y2="262" stroke="#5d6776" stroke-width="1.5" marker-end="url(#arrow-muted)"/>

                      <!-- THREE SHAPES ROW -->
                      <text x="490" y="248" text-anchor="middle" font-family="ui-monospace,monospace" font-size="10" font-weight="700" letter-spacing="0.15em" fill="#7d8694">ANY DATA-PROVIDER IMPLEMENTATION</text>

                      <!-- Shape 1: cms-vercel -->
                      <g filter="url(#shadow)">
                        <rect x="60" y="270" width="270" height="170" rx="12" fill="url(#grad-shape)" stroke="#2a3140"/>
                      </g>
                      <text x="80" y="296" font-family="ui-monospace,monospace" font-size="10" font-weight="700" fill="#5b8bff" letter-spacing="0.1em">SHAPE 1</text>
                      <text x="80" y="320" font-family="Inter,sans-serif" font-size="14" font-weight="600" fill="#e6edf3">cms-vercel</text>
                      <text x="80" y="338" font-family="Inter,sans-serif" font-size="11" fill="#7d8694">+ @casemaster/api-vercel</text>
                      <line x1="80" y1="354" x2="310" y2="354" stroke="#2a3140"/>
                      <text x="80" y="376" font-family="Inter,sans-serif" font-size="11.5" fill="#c0c9d6">One Vercel function. Greenfield.</text>
                      <text x="80" y="394" font-family="Inter,sans-serif" font-size="11.5" fill="#c0c9d6">Both classic HTML and SPA</text>
                      <text x="80" y="412" font-family="Inter,sans-serif" font-size="11.5" fill="#c0c9d6">on the same deploy.</text>
                      <g transform="translate(80, 422)">
                        <rect x="0" y="0" width="80" height="14" rx="7" fill="rgba(74,222,128,0.10)" stroke="rgba(74,222,128,0.3)"/>
                        <text x="40" y="11" text-anchor="middle" font-family="ui-monospace,monospace" font-size="9" font-weight="700" fill="#9ddfb1">PRODUCTION</text>
                      </g>

                      <!-- Shape 2: sidecar -->
                      <g filter="url(#shadow)">
                        <rect x="355" y="270" width="270" height="170" rx="12" fill="url(#grad-shape)" stroke="#2a3140"/>
                      </g>
                      <text x="375" y="296" font-family="ui-monospace,monospace" font-size="10" font-weight="700" fill="#5b8bff" letter-spacing="0.1em">SHAPE 2</text>
                      <text x="375" y="320" font-family="Inter,sans-serif" font-size="14" font-weight="600" fill="#e6edf3">cms-vercel sidecar</text>
                      <text x="375" y="338" font-family="Inter,sans-serif" font-size="11" fill="#7d8694">+ CaseMaster.Web.exe</text>
                      <line x1="375" y1="354" x2="605" y2="354" stroke="#2a3140"/>
                      <text x="375" y="376" font-family="Inter,sans-serif" font-size="11.5" fill="#c0c9d6">.exe keeps serving /page/*.</text>
                      <text x="375" y="394" font-family="Inter,sans-serif" font-size="11.5" fill="#c0c9d6">Sidecar serves /api/v1/*.</text>
                      <text x="375" y="412" font-family="Inter,sans-serif" font-size="11.5" fill="#c0c9d6">Same Postgres, same sessions.</text>
                      <g transform="translate(375, 422)">
                        <rect x="0" y="0" width="80" height="14" rx="7" fill="rgba(74,222,128,0.10)" stroke="rgba(74,222,128,0.3)"/>
                        <text x="40" y="11" text-anchor="middle" font-family="ui-monospace,monospace" font-size="9" font-weight="700" fill="#9ddfb1">PRODUCTION</text>
                      </g>

                      <!-- Shape 3: api-dotnet -->
                      <g filter="url(#shadow)">
                        <rect x="650" y="270" width="270" height="170" rx="12" fill="url(#grad-shape)" stroke="#2a3140"/>
                      </g>
                      <text x="670" y="296" font-family="ui-monospace,monospace" font-size="10" font-weight="700" fill="#5b8bff" letter-spacing="0.1em">SHAPE 3</text>
                      <text x="670" y="320" font-family="Inter,sans-serif" font-size="14" font-weight="600" fill="#e6edf3">CaseMaster.Web.exe</text>
                      <text x="670" y="338" font-family="Inter,sans-serif" font-size="11" fill="#7d8694">+ @casemaster/api-dotnet</text>
                      <line x1="670" y1="354" x2="900" y2="354" stroke="#2a3140"/>
                      <text x="670" y="376" font-family="Inter,sans-serif" font-size="11.5" fill="#c0c9d6">In-process C# plugin.</text>
                      <text x="670" y="394" font-family="Inter,sans-serif" font-size="11.5" fill="#c0c9d6">No sidecar required.</text>
                      <text x="670" y="412" font-family="Inter,sans-serif" font-size="11.5" fill="#c0c9d6">Same JSON contract.</text>
                      <g transform="translate(670, 422)">
                        <rect x="0" y="0" width="68" height="14" rx="7" fill="rgba(245,158,11,0.10)" stroke="rgba(245,158,11,0.3)"/>
                        <text x="34" y="11" text-anchor="middle" font-family="ui-monospace,monospace" font-size="9" font-weight="700" fill="#f4c478">SCAFFOLD</text>
                      </g>

                      <!-- arrows from each shape down to postgres -->
                      <line x1="195" y1="440" x2="430" y2="476" stroke="#5d6776" stroke-width="1.2" marker-end="url(#arrow-muted)"/>
                      <line x1="490" y1="440" x2="490" y2="476" stroke="#5d6776" stroke-width="1.2" marker-end="url(#arrow-muted)"/>
                      <line x1="785" y1="440" x2="550" y2="476" stroke="#5d6776" stroke-width="1.2" marker-end="url(#arrow-muted)"/>

                      <!-- POSTGRES -->
                      <g filter="url(#shadow)">
                        <rect x="340" y="478" width="300" height="50" rx="10" fill="url(#grad-pg)" stroke="#2c5742"/>
                      </g>
                      <text x="490" y="500" text-anchor="middle" font-family="Inter,sans-serif" font-size="13" font-weight="600" fill="#9ddfb1">Postgres (shared schema)</text>
                      <text x="490" y="518" text-anchor="middle" font-family="ui-monospace,monospace" font-size="11" fill="#5dac7a">cms_session  ·  BO tables  ·  LISTEN/NOTIFY</text>
                    </svg>
                    <p class="caption">All three shapes implement the same <code>/api/v1</code> contract; the SPA is one artefact across all of them.</p>
                </div>
            `>,

            packages: <@page/html `
                <h2>Package map</h2>
                <table>
                    <thead><tr><th>Package</th><th>Purpose</th></tr></thead>
                    <tbody>
                        <tr><td><code>@casemaster/api-spec</code></td><td>zod wire schemas + path constants. Source of truth.</td></tr>
                        <tr><td><code>@casemaster/api-vercel</code></td><td>JSON adapter + <code>DataProvider</code> interface. Demo and cms-vercel-backed providers.</td></tr>
                        <tr><td><code>@casemaster/admin</code></td><td>React SPA: shell, DataTable, BoForm, Cmd-K, Dashboard, Copilot.</td></tr>
                        <tr><td><code>create-cms-admin</code></td><td><code>npm create cms-admin@latest</code> scaffold.</td></tr>
                        <tr><td><code>@casemaster/api-dotnet</code></td><td>C# scaffold for an in-process .NET adapter (Phase 7).</td></tr>
                    </tbody>
                </table>
            `>,

            lifecycle: <@page/html `
                <h2>Request lifecycle</h2>
                <ol>
                    <li>Browser hits <code>/admin/wms/inventory</code>.</li>
                    <li>SPA fetches <code>/api/v1/schema</code> (cached 30 min) → BO + page descriptors.</li>
                    <li>SPA renders <code>&lt;DataTable bo="wms/inventory" /&gt;</code>.</li>
                    <li>Table fetches <code>/api/v1/bo/wms/inventory/list?...</code> via TanStack Query.</li>
                    <li>User clicks a row → SPA calls <code>/api/v1/bo/wms/inventory/get?id=42</code>.</li>
                    <li>User edits a field → optimistic mutation: TanStack Query patches every cached list query for that BO before the network round-trip.</li>
                    <li>Server responds; on success the toast confirms; on error the cache rolls back and the toast carries the message.</li>
                    <li>Provider broadcasts the change; SSE subscribers (<code>useLive</code>) receive it and invalidate the affected query keys.</li>
                </ol>
            `>,

            actions: <@page/html `
                <h2>Page actions reuse existing .cms code</h2>
                <p>The endpoint <code>/api/v1/page/:path/:fn</code> runs a <code>.cms</code> page function on
                the server. The function publishes results via <code>set('//act_*', value)</code>; the
                adapter collects every <code>act_*</code> global into the JSON <code>outputs</code>.</p>
                <pre><code>SPA  POST /api/v1/page/wms/inbound/receive  { asn:1, qty_5:2 }
   ↓
adapter ← runs page/wms/inbound:receive on the runtime
   ↓
{ ok: true, outputs: { act_rcpt_id: 13, act_lines_received: 1, act_msg: '…' } }</code></pre>
                <p>This is how the WMS receive flow runs without rewriting <code>postReceive</code>.</p>
            `>,

            live: <@page/html `
                <h2>Live updates via Postgres LISTEN/NOTIFY</h2>
                <p><code>/api/v1/stream/:bo</code> is an SSE endpoint. The DataProvider exposes an optional
                <code>events: BoEventBroadcaster</code>; in production the broadcaster holds a dedicated pg
                connection and <code>LISTEN</code>s on <code>cms_bo:&lt;name&gt;</code> channels.</p>
                <p>One CLI installs the triggers:</p>
                <pre><code>npx cms-admin-emit-live-sql --app ./app | psql $DATABASE_URL</code></pre>
                <p>Then writes from cms-vercel HTML pages, batch jobs, the SPA, or the .exe all propagate to
                every connected SPA in real time.</p>
            `>,

            auth: <@page/html `
                <h2>Authentication</h2>
                <p>Cookies, no JWT. The SPA calls <code>/api/v1/session/me</code> on boot, which returns the
                current user, their permissions, and a CSRF token. Every state-changing request carries
                <code>X-CSRF-Token</code> from that token.</p>
                <p>Both runtimes share the <code>cms_session</code> table. A user signed in via classic HTML
                stays signed in when they hit the SPA; the SPA presents the same <code>cmsv_sid</code> cookie
                and the runtime hydrates the session from the table.</p>
            `>,

            body_c: <@page/html `</div></div>`>
        >
    >
end-resource
