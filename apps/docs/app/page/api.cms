inherits 'base'

function main()
    page.render(page.get('./main'))
end-function

protected resource main
    <@page/container
        content: <@page/content
            wrap:   <@page/html `<div class="cms-layout">`>,
            side:   <@page/html script.call('_layout:sidebar', 'api')>,
            body_o: <@page/html `<div class="cms-content">`>,

            head: <@page/html `
                <h1>JSON API reference</h1>
                <p class="lead">
                    The contract every backend implements. Source of truth: zod schemas in
                    <code>packages/api-spec/src/schemas.ts</code>. OpenAPI 3.1 generated by
                    <code>npx tsx packages/api-spec/src/openapi.ts</code>.
                </p>
            `>,

            routes: <@page/html `
                <h2>Routes</h2>
                <table>
                    <thead><tr><th>Method</th><th>Path</th><th>Purpose</th></tr></thead>
                    <tbody>
                        <tr><td><code>GET</code></td><td><code>/api/v1/schema</code></td><td>BOs + pages + nav + capabilities</td></tr>
                        <tr><td><code>GET</code></td><td><code>/api/v1/bo/:bo/list</code></td><td>Paginated list with sort/filter/search</td></tr>
                        <tr><td><code>GET</code></td><td><code>/api/v1/bo/:bo/get</code></td><td>Single record + FK label resolution</td></tr>
                        <tr><td><code>POST</code></td><td><code>/api/v1/bo/:bo/save</code></td><td>INSERT or UPDATE through bo.persist</td></tr>
                        <tr><td><code>POST</code></td><td><code>/api/v1/bo/:bo/delete</code></td><td>DELETE by primary key</td></tr>
                        <tr><td><code>POST</code></td><td><code>/api/v1/page/:path/:fn</code></td><td>Run a .cms function as a JSON action</td></tr>
                        <tr><td><code>GET</code></td><td><code>/api/v1/session/me</code></td><td>User, perms, CSRF</td></tr>
                        <tr><td><code>POST</code></td><td><code>/api/v1/session/login</code></td><td>Cookie login</td></tr>
                        <tr><td><code>POST</code></td><td><code>/api/v1/session/logout</code></td><td>Clear session</td></tr>
                        <tr><td><code>GET</code></td><td><code>/api/v1/preferences/:scope</code></td><td>Per-user preferences (read)</td></tr>
                        <tr><td><code>PUT</code></td><td><code>/api/v1/preferences/:scope</code></td><td>Per-user preferences (write)</td></tr>
                        <tr><td><code>GET</code></td><td><code>/api/v1/stream/:bo</code></td><td>SSE stream of insert/update/delete events</td></tr>
                    </tbody>
                </table>
            `>,

            list: <@page/html `
                <h2>GET /api/v1/bo/:bo/list</h2>
                <pre><code>GET /api/v1/bo/wms/inventory/list
  ?group=list
  &amp;page=1
  &amp;pageSize=50
  &amp;sort=-qty_on_hand,item_id
  &amp;q=SKU-1001
  &amp;filter[quality_status]=AVAILABLE
  &amp;filter[quality_status]=QUARANTINE</code></pre>
                <p>Notes:</p>
                <ul>
                    <li><code>filter[col]</code> repeats per value (URL-encoded as <code>filter%5Bcol%5D</code>).</li>
                    <li><code>sort</code> is comma-separated; prefix <code>-</code> for descending.</li>
                    <li><code>q</code> is free-text against the BO's label group columns.</li>
                </ul>
                <pre><code>{
  "rows": [...],
  "total": 132,
  "page": 1,
  "pageSize": 50,
  "group": "list",
  "columns": [{"name":"item_id","label":"Item","type":"long","fk":"wms/item"}, ...]
}</code></pre>
            `>,

            page_action: <@page/html `
                <h2>POST /api/v1/page/:path/:fn</h2>
                <p>Runs a <code>.cms</code> function. Conventionally the function publishes results via
                <code>set('//act_*', value)</code>:</p>
                <pre><code>POST /api/v1/page/wms/inbound/receive
{ "asn": 1, "qty_5": 2, "lot_5": "LOT-DEMO" }

→  {
     "ok": true,
     "outputs": {
       "act_rcpt_id": 13,
       "act_lines_received": 1,
       "act_msg": "Receipt RC-..."
     },
     "message": "Receipt RC-..."
   }</code></pre>
            `>,

            stream: <@page/html `
                <h2>GET /api/v1/stream/:bo  (SSE)</h2>
                <pre><code>GET /api/v1/stream/wms/inventory
Content-Type: text/event-stream

: connected to wms/inventory

data: {"bo":"wms/inventory","kind":"insert","id":42}

data: {"bo":"wms/inventory","kind":"update","id":42}

: ping

data: {"bo":"wms/inventory","kind":"delete","id":42}</code></pre>
                <p>The SPA's <code>useLive(bo)</code> hook subscribes and invalidates the matching TanStack
                Query keys on every event. Heartbeats every 25s keep load balancers from killing the stream.</p>
            `>,

            auth: <@page/html `
                <h2>Auth</h2>
                <p>Every request: <code>cmsv_sid</code> cookie (HttpOnly, SameSite=Lax, Secure).
                State-changing requests: <code>X-CSRF-Token</code> from <code>/session/me</code>.</p>
                <p>Errors: any non-2xx response is JSON of shape
                <code>{ ok:false, error:"...", code?:"...", fields?:{...} }</code>.</p>
            `>,

            body_c: <@page/html `</div></div>`>
        >
    >
end-resource
