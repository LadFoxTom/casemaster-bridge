// Landing page. Frames the live deployment of the full 164-BO
// Casemaster-WMS running through the bridge.

inherits 'base'

function main()
    page.render(page.get('./main'))
end-function

protected resource main
    <@page/container
        content: <@page/content
            wrap: <@page/html `<div class="cms-layout">`>,
            side: <@page/html script.call('_layout:sidebar', 'home')>,
            body_open: <@page/html `<div class="cms-content">`>,

            hero: <@page/html `
                <div class="hero">
                    <div class="eyebrow">casemaster-bridge · live</div>
                    <h1>The same .cms source.<br>A 2026 admin UI.<br>Both runtimes.</h1>
                    <p class="lead">
                        Casemaster Bridge wraps any CaseMaster app in a polished React SPA: Cmd-K command
                        palette, virtualized data grids, optimistic mutations, dark mode, schema-driven
                        navigation. The runtime stays yours — <code>cms-vercel</code> on Vercel, or
                        <code>CaseMaster.Web.exe</code> on Windows with a JSON sidecar. The same
                        <code>.cms</code> files. Untouched.
                    </p>
                    <div class="cta">
                        <a class="btn btn-primary" href="https://casemaster-bridge-demo.vercel.app/" target="_blank">Open the live WMS demo →</a>
                        <a class="btn btn-outline-secondary" href="https://github.com/LadFoxTom/casemaster-bridge" target="_blank">GitHub ↗</a>
                    </div>
                    <div class="tag-row" style="margin-top:1.5rem">
                        <span class="tag ok">🟢 Live · 164-BO WMS · Neon Postgres</span>
                        <span class="tag ok">cms-vercel ready</span>
                        <span class="tag ok">.NET sidecar ready</span>
                        <span class="tag todo">.NET in-process plugin (scaffold)</span>
                        <span class="tag ok">WCAG 2.2 AA</span>
                    </div>
                </div>
            `>,

            demo: <@page/html `
                <div class="demo-frame">
                    <div class="chrome">
                        <div class="dots"><span></span><span></span><span></span></div>
                        <div class="url">https://casemaster-bridge-demo.vercel.app/admin/#/wms/inventory</div>
                        <div class="badge-live">● Live</div>
                    </div>
                    <iframe src="https://casemaster-bridge-demo.vercel.app/admin/#/wms/inventory" loading="lazy" title="Live WMS deployment"></iframe>
                    <div class="frame-footer">
                        <span>The full <strong>164-BO Casemaster-WMS</strong>, written in standard <code>.cms</code>, served by <code>cms-vercel</code> + Neon Postgres, with the Bridge SPA on top.</span>
                        <a href="https://casemaster-bridge-demo.vercel.app/admin/" target="_blank">Open in new tab ↗</a>
                    </div>
                </div>
            `>,

            try: <@page/html `
                <h2>Try it</h2>
                <p>
                    The frame above is the real production deployment — same Vercel function, same Neon
                    database, same React SPA you'd ship to your operators. Inside:
                </p>
                <ul>
                    <li>Press <kbd>⌘</kbd><kbd>K</kbd> (or <kbd>Ctrl</kbd><kbd>K</kbd>) — fuzzy-search across all 164 BOs and every page</li>
                    <li>Press <kbd>?</kbd> — see the keyboard shortcut registry (Linear-class)</li>
                    <li>Press <kbd>g</kbd> <kbd>i</kbd> — jump to inventory; <kbd>g</kbd> <kbd>a</kbd> — ASNs; <kbd>g</kbd> <kbd>o</kbd> — orders</li>
                    <li>Click any BO in the sidebar — virtualized data grid against real Postgres rows</li>
                    <li>Toggle dark/light theme, compact/cozy/comfortable density</li>
                </ul>
            `>,

            deployed: <@page/html `
                <h2>What's deployed where</h2>
                <table>
                    <thead><tr><th>Service</th><th>URL</th><th>What it is</th></tr></thead>
                    <tbody>
                        <tr>
                            <td><strong>The live WMS</strong></td>
                            <td><a href="https://casemaster-bridge-demo.vercel.app/" target="_blank">casemaster-bridge-demo.vercel.app</a></td>
                            <td>Full 164-BO Casemaster-WMS, Bridge SPA on top, Neon Postgres backend</td>
                        </tr>
                        <tr>
                            <td><strong>These docs</strong></td>
                            <td><a href="https://casemaster-bridge-docs.vercel.app/" target="_blank">casemaster-bridge-docs.vercel.app</a></td>
                            <td>This site — itself a <code>cms-vercel</code> project</td>
                        </tr>
                        <tr>
                            <td><strong>Source</strong></td>
                            <td><a href="https://github.com/LadFoxTom/casemaster-bridge" target="_blank">github.com/LadFoxTom/casemaster-bridge</a></td>
                            <td>Monorepo: SPA, JSON adapter, demo, docs, .NET scaffold</td>
                        </tr>
                    </tbody>
                </table>
            `>,

            cards: <@page/html `
                <h2>Read more</h2>
                <div class="cards">
                    <a class="card-doc" href="/page/cms-vercel">
                        <div class="icon">▲</div>
                        <h3>Install on cms-vercel</h3>
                        <p>Greenfield path. Drop the JSON adapter into <code>api/v1</code>, build the SPA, deploy. One Vercel function.</p>
                    </a>
                    <a class="card-doc" href="/page/dotnet">
                        <div class="icon">⚙</div>
                        <h3>CaseMaster.Web.exe sidecar</h3>
                        <p>Run cms-vercel as a JSON sidecar against your existing Postgres. Your <code>.exe</code> stays untouched.</p>
                    </a>
                    <a class="card-doc" href="/page/iis">
                        <div class="icon">▢</div>
                        <h3>IIS deployment</h3>
                        <p>Hostname-shared topology with URL Rewrite + ARR proxying <code>/api/v1/*</code> to a Node sidecar.</p>
                    </a>
                    <a class="card-doc" href="/page/architecture">
                        <div class="icon">◧</div>
                        <h3>Architecture</h3>
                        <p>Request lifecycle, page-action flow, the runtime-agnostic JSON contract, security model.</p>
                    </a>
                    <a class="card-doc" href="/page/api">
                        <div class="icon">⇄</div>
                        <h3>JSON API</h3>
                        <p>Every <code>/api/v1/*</code> route, request shape, and response shape. Backed by zod.</p>
                    </a>
                    <a class="card-doc" href="/page/why">
                        <div class="icon">★</div>
                        <h3>Why this exists</h3>
                        <p>Twelve research takeaways from 2026 admin-UI patterns, mapped to features.</p>
                    </a>
                </div>
            `>,

            quick: <@page/html resolveTemplate(`
                <h2>30-second self-host</h2>
                <pre><code># 1. Clone
git clone https://github.com/LadFoxTom/casemaster-bridge
cd casemaster-bridge/examples/wms-vercel

# 2. Install (vendors cms-vercel automatically)
npm install

# 3. Point at your Postgres (or use the demo provider — no DB needed)
export DATABASE_URL='postgres://user:pw@host/db'
psql "$DATABASE_URL" -f sql/wms_schema.sql

# 4. Deploy
vercel --prod</code></pre>
                <p class="text-muted">These docs are rendered by the same cms-vercel runtime they describe. Page rendered at <code>{{now()}}</code>.</p>
            `)>,

            body_close: <@page/html `</div></div>`>
        >
    >
end-resource
