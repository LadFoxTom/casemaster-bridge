inherits 'base'

function main()
    page.render(page.get('./main'))
end-function

protected resource main
    <@page/container
        content: <@page/content
            wrap:   <@page/html `<div class="cms-layout">`>,
            side:   <@page/html script.call('_layout:sidebar', 'road')>,
            body_o: <@page/html `<div class="cms-content">`>,

            head: <@page/html `
                <h1>Roadmap status</h1>
                <p class="lead">Where the package is in May 2026 — and what's actually deployed.</p>
            `>,

            live: <@page/html `
                <h2>🟢 Live deployments</h2>
                <table>
                    <thead><tr><th>What</th><th>URL</th><th>Stack</th></tr></thead>
                    <tbody>
                        <tr>
                            <td><strong>Bridge demo</strong></td>
                            <td><a href="https://casemaster-bridge-demo.vercel.app/" target="_blank">casemaster-bridge-demo.vercel.app</a></td>
                            <td>164-BO Casemaster-WMS · cms-vercel runtime · Neon Postgres · Bridge SPA</td>
                        </tr>
                        <tr>
                            <td><strong>Docs (this site)</strong></td>
                            <td><a href="https://casemaster-bridge-docs.vercel.app/" target="_blank">casemaster-bridge-docs.vercel.app</a></td>
                            <td>cms-vercel-rendered <code>.cms</code> pages · no database</td>
                        </tr>
                    </tbody>
                </table>
                <p>Both deploy from the same monorepo: <a href="https://github.com/LadFoxTom/casemaster-bridge" target="_blank">github.com/LadFoxTom/casemaster-bridge</a>. Two Vercel projects, different Root Directory.</p>
            `>,

            phases: <@page/html `
                <h2>Phases</h2>
                <table>
                    <thead><tr><th>Phase</th><th>Scope</th><th>Status</th></tr></thead>
                    <tbody>
                        <tr><td>0</td><td>Walking skeleton + runnable demo</td><td><span class="tag ok">done</span></td></tr>
                        <tr><td>1</td><td>JSON API parity (read paths) + OpenAPI + tests</td><td><span class="tag ok">done · live</span></td></tr>
                        <tr><td>2</td><td>SPA shell + Cmd-K + DataTable + theme/density</td><td><span class="tag ok">done · live</span></td></tr>
                        <tr><td>3</td><td>Optimistic mutations + react-hook-form + bo.persist routing</td><td><span class="tag ok">done · live</span></td></tr>
                        <tr><td>4</td><td>Page actions + master-detail + Dashboard composer</td><td><span class="tag ok">done · live</span></td></tr>
                        <tr><td>5</td><td>Postgres LISTEN/NOTIFY + Copilot (BYO key)</td><td><span class="tag ok">done</span></td></tr>
                        <tr><td>6</td><td>axe-core CI + Playwright E2E + create-CLI + docs</td><td><span class="tag ok">done · live</span></td></tr>
                        <tr><td>7</td><td>C# in-process adapter (api-dotnet)</td><td><span class="tag todo">scaffold only</span></td></tr>
                    </tbody>
                </table>
            `>,

            ship: <@page/html `
                <h2>What's shippable today</h2>
                <ul>
                    <li><strong>cms-vercel deployments</strong> — production-ready. Proven by the live demo: 164 BOs, real Postgres, full BO machinery.</li>
                    <li><strong>CaseMaster.Web.exe + sidecar</strong> — production-ready. The same Bridge SPA bundle works against either runtime; only the host of the JSON adapter changes.</li>
                    <li><strong>IIS-fronted hybrid</strong> — production-ready (see <a href="/page/iis">IIS guide</a>). URL Rewrite + ARR forwards <code>/api/v1/*</code> to a Node sidecar.</li>
                </ul>
                <h2>What's not shippable today</h2>
                <ul>
                    <li><strong>In-process .NET plugin</strong> (Shape 3) — controllers and IDataProvider interface are in place; the <code>CaseMasterDataProvider.cs</code> implementation needs filling against the actual <code>Casemaster.dll</code> API surface. ~2 months of focused C# work. <strong>Only required</strong> for sites that genuinely cannot run any sidecar process.</li>
                </ul>
            `>,

            body_c: <@page/html `</div></div>`>
        >
    >
end-resource
